# Copy to .env.local and fill in. Never commit real keys.

# Deploys contracts to Celo Sepolia. Testnet-only key, funded from https://faucet.celo.org/celo-sepolia
DEPLOYER_PRIVATE_KEY=

# Signs simulated meter readings server-side (the "oracle"). Its address is registered in ReadingRegistry.
METER_SIGNER_PRIVATE_KEY=

# Contract addresses on Celo Sepolia, filled in after deployment.
NEXT_PUBLIC_READING_REGISTRY_ADDRESS=
NEXT_PUBLIC_REC_TOKEN_ADDRESS=
NEXT_PUBLIC_ENERGY_MARKET_ADDRESS=

# "seeded" keeps the offline demo; "chain" reads and writes Celo Sepolia.
NEXT_PUBLIC_DATA_SOURCE=seeded
